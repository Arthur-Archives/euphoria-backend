{
  "name": "ed-api",
  "version": "1.0.0",
  "type": "module",
  "repository": "https://github.com/EuphoriaTheme/backend.git",
  "author": "Rep Graphics <support@euphoriadevelopment.uk>",
  "contributors": [
    "KingIronMan2011 <IronMan@king-mc.de> (https://kingironman.dev)"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc && node -e \"require('node:fs').cpSync('public', 'dist/public', { recursive: true })\"",
    "start": "node dist/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc --noEmit",
    "types:telemetry": "tsc -p tsconfig.telemetry.json",
    "test:telemetry": "tsx --test tests/telemetry*.test.ts",
    "test:telemetry:integration": "node scripts/testTelemetry.mjs",
    "telemetry:init": "node scripts/initTelemetry.mjs",
    "telemetry:setup": "docker compose --env-file .env.telemetry -f compose.telemetry.yaml run --rm setup",
    "telemetry:import": "tsx scripts/importTelemetry.ts",
    "update:games": "tsx ./scripts/updateGamesYml.ts",
    "fetch:gameicons": "tsx ./scripts/fetchGameIcons.ts",
    "sync:translations": "tsx ./scripts/syncTranslations.ts",
    "sync:blueprint": "tsx ./scripts/syncBlueprintExtensions.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "axios": "^1.20.0",
    "dotenv": "^18.0.0",
    "fastify": "^5.12.5",
    "gamedig": "^5.3.3",
    "js-yaml": "^5.4.2",
    "pg": "^8.23.1",
    "rcon-client": "^4.2.5",
    "rcon-srcds": "^2.1.1",
    "redis": "^6.2.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
